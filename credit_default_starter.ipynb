    "def evaluate_policy(threshold) :\n",
    "    approved = results[results['pd'] < threshold]\n",
    "    approval_rate = len(approved) / len(results)\n",
    "    total_profit = approved['exp_profit'].sum()\n",
    "    total_loss = approved['exp_loss'].sum()\n",
    "    bad_rate = y_test[results['pd'] < threshold].mean()\n",
    "\n",
    "    return approval_rate, total_profit, total_loss, bad_rate\n",
