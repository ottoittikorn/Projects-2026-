    "# TODO: plot the class balance as a bar chart so you SEE the imbalance\n",
    "sns.countplot(x='default', data=df)\n",
    "\n",
    "# Reflection: if you built a model that just predicted '0' (no default) for everyone,\n",
    "# what accuracy would it get? Is that a useful model? (This is the imbalance trap.)\n",
    "# Imbalance data -> Because only 22% defaulted, a model predcing 0 for everyone would still be 78% \n",
    "# hence evaluate on Recall, Precision, good and bad customer, \n"
   ]
